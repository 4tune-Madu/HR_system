DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-unique-random-value-of-at-least-50-characters
ALLOWED_HOSTS=hr.company.example
APP_BASE_URL=https://hr.company.example
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://hr.company.example
DB_NAME=hr_system
DB_USER=hr_app
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=5432
EMAIL_HOST=smtp.company.example
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=hr@company.example
STATIC_ROOT=C:/HRSystem/data/static
# Private uploads: do not publish this directory through IIS.
MEDIA_ROOT=C:/HRSystem/data/media
CELERY_BROKER_URL=redis://worker.company.example:6379/0
CELERY_RESULT_BACKEND=redis://worker.company.example:6379/1
# True only when the trusted reverse proxy controls X-Forwarded-Proto.
TRUST_PROXY_HTTPS=false
